# 跨平台行尾统一 —— 团队里同时有 Windows / macOS / Linux 时必须做
# 不加这个文件，Windows 提交会把 LF 转成 CRLF，Linux 上的 shell 脚本会直接报
# "bad interpreter: /bin/sh^M"，Docker 构建也可能受影响。

# 默认：仓库内一律存 LF，检出时按平台自动转换
* text=auto

# 源码与配置：强制 LF
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
Dockerfile   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows 批处理：强制 CRLF，否则 cmd.exe 解析 goto 标签会出错
*.bat   text eol=crlf
*.cmd   text eol=crlf

# shell 脚本：强制 LF，否则 Linux 无法执行
*.sh    text eol=lf

# 二进制：不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
