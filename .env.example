# ============================================
# 海龟汤网站 — 环境变量配置示例
# 使用方式：复制本文件为 .env（或在启动时 export 这些变量）
# ============================================

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=这里填你的数据库密码
DB_NAME=haiguitang

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-random-secret
